# Copy to .env.local (never committed) and fill in.

# Neon connection string (pooled).
DATABASE_URL=

# Development only: lets `npm run db:seed:dev` and the end-to-end tests ERASE the database.
# Never set this in production.
OCD_ALLOW_DB_RESET=

# Optional: e-mail alert to the manager for each new booking, sent through Resend.
# Without these, alerts only appear in the admin dashboard.
RESEND_API_KEY=
MANAGER_ALERT_EMAIL=
ALERT_FROM_EMAIL=
